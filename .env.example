# LLM Gateway — required environment variables
# Copy this file to .env and fill in the values

# Provider API keys
ANTHROPIC_API_KEY=blahblahblah
OPENAI_API_KEY=blahblahblah

# Admin API key (used for /admin/* endpoints)
ADMIN_API_KEY=change-me-in-production

# Database (overridden in docker-compose to point at the postgres container)
DATABASE_URL=postgresql+asyncpg://gateway:gateway@localhost:5432/gateway

# Redis (overridden in docker-compose to point at the redis container)
REDIS_URL=redis://localhost:6379

# Local Ollama (Phase 2.2). Gateway container reaches host Ollama via
# host.docker.internal; the host needs `ollama serve` running and the model
# pulled (`ollama pull qwen2:7b`).
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Logging
LOG_LEVEL=INFO
LOG_JSON=true

# App
APP_VERSION=0.1.0

# Phase 2.5 — LLM-as-judge production sampling backstop. Off by default
# because every sampled response costs an Opus call. Set to true to enable;
# JUDGE_SAMPLE_RATE controls how often (default 0.01 = 1% of responses).
JUDGE_SAMPLING_ENABLED=false
JUDGE_SAMPLE_RATE=0.01
